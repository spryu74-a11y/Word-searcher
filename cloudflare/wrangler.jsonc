{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "word-searcher",
  "main": "./src/worker.js",
  "compatibility_date": "2026-07-13",
  "minify": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "OPENDICT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 10
      }
    },
    {
      "name": "OPENDICT_GLOBAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
